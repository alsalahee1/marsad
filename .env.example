# Copy to .env and fill in. .env is gitignored — keep it that way.

NODE_ENV=development
PORT=8080
# Comma-separated exact origins. Never "*" — the desk sends credentials.
CORS_ORIGINS=http://localhost:5173
# Express `trust proxy`: loopback for Nginx on the same host, false when exposed directly.
# Never "true" — that lets a client spoof the IP the login rate-limit keys on.
TRUST_PROXY=loopback
LOG_LEVEL=info

# --- Data ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=marsad
# Runtime account. Gets table-level grants only (SELECT+INSERT on events, no UPDATE/DELETE).
# docker-compose dev value: marsad_app / marsad_app_dev
MYSQL_USER=marsad_app
MYSQL_PASSWORD=
# Host part of the runtime account ('marsad_app'@'%'), used when granting.
MYSQL_APP_USER_HOST=%
# Schema owner used only by `pnpm db:migrate`. docker-compose dev value: marsad_migrate / marsad_migrate_dev
MYSQL_MIGRATE_USER=marsad_migrate
MYSQL_MIGRATE_PASSWORD=

REDIS_URL=redis://127.0.0.1:6379

# --- Auth (single operator) ---
# At least 32 random characters. Rotating it invalidates every session.
SESSION_SECRET=
# Session cookie lifetime (12h). Re-login after this.
SESSION_TTL_MS=43200000
# Argon2id hash of your password: `pnpm --filter @marsad/engine hash-password`. Never the password itself.
OPERATOR_PASSWORD_HASH=

# --- Run ceilings: read at boot, enforced in the executor ---
RUN_MAX_STEPS=40
RUN_MAX_TOKENS=250000
RUN_MAX_WALL_CLOCK_MS=900000

# --- Spend caps for `costly` tools: enforced before the call, not in the prompt ---
BUDGET_PER_RUN_USD=2.00
BUDGET_PER_DAY_USD=25.00
BUDGET_PER_DAY_CALLS=200
# An approval token is valid this long after the desk requests it (10 min), and usable once.
APPROVAL_TOKEN_TTL_MS=600000

# --- Model provider ---
ANTHROPIC_API_KEY=
AGENT_MODEL=

# ---------------------------------------------------------------
# NOT configurable, by design — do not add env vars for these:
#   * bypassing the approval queue for `irreversible` tools
#   * disabling the append-only constraint on the events table
#   * disabling the global halt switch
# If a future task asks for one of these flags, the task is wrong.
# ---------------------------------------------------------------
