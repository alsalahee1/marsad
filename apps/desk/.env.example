# Copy to apps/desk/.env.local (gitignored) to override. Only VITE_* keys reach the bundle;
# never put a credential here — the desk holds no secrets, the engine holds them all.

# Where the engine is. Same-site with the desk, or the SameSite=Strict session cookie is never
# sent: `localhost` and `127.0.0.1` are different sites. Defaults: http://localhost:8080 in dev,
# /api in a production build (Nginx strips the prefix and proxies to the engine).
VITE_API_BASE=http://localhost:8080
